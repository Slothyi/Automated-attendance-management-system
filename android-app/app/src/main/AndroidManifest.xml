<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🌐 INTERNET -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 📸 CAMERA -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- 📍 LOCATION -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- 📡 BLUETOOTH -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"/>

    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"/>

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"/>

    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>

    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- 📸 CAMERA FEATURE -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AttendancePRO"
        android:usesCleartextTraffic="true">

        <!-- 🚀 SPLASH SCREEN -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AttendancePRO.Splash">

            <intent-filter>

                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>

            </intent-filter>

        </activity>

        <!-- 👥 ROLE SELECTION -->
        <activity
            android:name=".activities.RoleSelectionActivity"
            android:exported="true"/>

        <!-- 🎓 STUDENT LOGIN -->
        <activity
            android:name=".activities.StudentLoginActivity"
            android:exported="true"/>

        <!-- 👨‍💼 ADMIN LOGIN -->
        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="true"/>

        <!-- 👨‍💼 ADMIN DASHBOARD -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false"/>

        <!-- 🏫 CREATE CLASS -->
        <activity
            android:name=".activities.CreateClassActivity"
            android:exported="false"/>

        <!-- 👨‍🎓 ADD STUDENTS -->
        <activity
            android:name=".activities.AddStudentsActivity"
            android:exported="false"/>

        <!-- 📚 CLASS DETAILS -->
        <activity
            android:name=".activities.ClassStudentsActivity"
            android:exported="false"/>

        <!-- 📊 STUDENT DASHBOARD -->
        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.CalendarActivity"/>

        <!-- 📅 STUDENT CALENDAR -->
        <activity
            android:name=".activities.StudentCalendarActivity"
            android:exported="false"/>

        <!-- 📸 ATTENDANCE -->
        <activity
            android:name=".activities.AttendanceActivity"
            android:exported="false"/>

        <!-- 👤 PROFILE -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"/>

        <!-- 🎓 STUDENT CLASSES -->
        <activity
            android:name=".activities.StudentClassesActivity"
            android:exported="false"/>

        <!-- 🆕 REGISTER -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"/>

        <!-- 🔑 FORGOT PASSWORD -->
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"/>

        <!-- 🛡️ LIVENESS DETECTION -->
        <activity
            android:name=".activities.LivenessDetectionActivity"
            android:screenOrientation="portrait"
            android:exported="false"/>

        <!-- OPTIONAL -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.AttendanceReportActivity"
            android:exported="false"/>

        <!-- 🔥 FILE PROVIDER -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>

        </provider>

    </application>

</manifest>