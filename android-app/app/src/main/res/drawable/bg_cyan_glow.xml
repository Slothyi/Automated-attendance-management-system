<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OUTER -->
    <item>

        <shape>

            <solid android:color="#1200D9FF"/>

            <corners android:radius="30dp"/>

        </shape>

    </item>

    <!-- MAIN -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>

            <gradient
                android:angle="0"
                android:startColor="#0A395A"
                android:endColor="#04253C"/>

            <corners android:radius="28dp"/>

            <stroke
                android:width="1dp"
                android:color="#4400D9FF"/>

        </shape>

    </item>

</layer-list>