<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_futuristic_main">

    <!-- TECH BACKGROUND -->
    <com.example.attendancepro.activities.TechBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"/>

    <!-- PARTICLES -->
    <com.example.attendancepro.utils.ParticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"/>

    <!-- BOTTOM GLOW -->
    <com.example.attendancepro.activities.WavyMeshView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_alignParentBottom="true"
        android:clickable="false"
        android:focusable="false"/>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="90dp"
            android:paddingBottom="30dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Admin Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <!-- SUBTITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Manage classes and students"
                android:textColor="#A8C6D8"
                android:textSize="15sp"
                android:layout_marginBottom="28dp"/>

            <!-- GLASS CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/bg_glass_card">

                <!-- CLASS TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Your Classes"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- ROUNDED RECYCLER CONTAINER -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginBottom="28dp"
                    android:backgroundTint="#142B3A"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#223F52">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerClasses"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"/>

                </com.google.android.material.card.MaterialCardView>

                <!-- CREATE CLASS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateClass"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Create Class"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1294DB"
                    app:cornerRadius="30dp"/>

                <!-- SPACE -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <!-- ADD STUDENTS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddStudents"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Add Students"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0D7FC2"
                    app:cornerRadius="30dp"/>

                <!-- SPACE -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <!-- LOGOUT -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D9534F"
                    app:cornerRadius="30dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>