<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/drawerLayout"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/bg_futuristic_main">

    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TECH BACKGROUND -->
        <com.example.attendancepro.activities.TechBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"/>

        <!-- PARTICLES -->
        <com.example.attendancepro.utils.ParticleView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"/>

        <!-- BOTTOM GLOW -->
        <com.example.attendancepro.activities.WavyMeshView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_alignParentBottom="true"
            android:clickable="false"
            android:focusable="false"/>

        <!-- SCROLL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="24dp"
                android:paddingEnd="24dp"

                android:paddingTop="70dp"
                android:paddingBottom="30dp">

                <!-- ========================= -->
                <!-- TOP BAR -->
                <!-- ========================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:gravity="center_vertical"

                    android:layout_marginBottom="22dp">

                    <!-- TITLE AREA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">

                        <!-- TITLE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Admin Dashboard"

                            android:textColor="#FFFFFF"

                            android:textSize="32sp"

                            android:textStyle="bold"/>

                        <!-- SUBTITLE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Manage classes and students"

                            android:textColor="#A8C6D8"

                            android:textSize="15sp"

                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- ☰ MENU -->
                    <ImageView
                        android:id="@+id/btnMenu"

                        android:layout_width="48dp"
                        android:layout_height="48dp"

                        android:padding="10dp"

                        android:src="@drawable/ic_menu"

                        app:tint="#FFFFFF"/>
                </LinearLayout>

                <!-- ========================= -->
                <!-- GLASS CARD -->
                <!-- ========================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="22dp"

                    android:background="@drawable/bg_glass_card">

                    <!-- CLASS TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center"

                        android:text="Your Classes"

                        android:textColor="#FFFFFF"

                        android:textSize="20sp"

                        android:textStyle="bold"

                        android:layout_marginBottom="16dp"/>

                    <!-- RECYCLER -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="190dp"

                        android:layout_marginBottom="28dp"

                        android:backgroundTint="#142B3A"

                        app:cardCornerRadius="28dp"

                        app:cardElevation="0dp"

                        app:strokeWidth="1dp"

                        app:strokeColor="#223F52">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerClasses"

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="15dp"
                            android:paddingBottom="4dp"

                            android:clipToPadding="false"

                            android:overScrollMode="never"/>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- CREATE CLASS -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateClass"

                        android:layout_width="match_parent"
                        android:layout_height="58dp"

                        android:text="Create Class"

                        android:textAllCaps="false"

                        android:textStyle="bold"

                        android:textSize="16sp"

                        android:textColor="#FFFFFF"

                        android:backgroundTint="#1294DB"

                        app:cornerRadius="30dp"/>

                    <!-- SPACE -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- ADD STUDENTS -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddStudents"

                        android:layout_width="match_parent"
                        android:layout_height="58dp"

                        android:text="Add Students"

                        android:textAllCaps="false"

                        android:textStyle="bold"

                        android:textSize="16sp"

                        android:textColor="#FFFFFF"

                        android:backgroundTint="#0D7FC2"

                        app:cornerRadius="30dp"/>

                    <!-- SPACE -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- SESSION -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSession"

                        android:layout_width="match_parent"
                        android:layout_height="58dp"

                        android:text="Start Session"

                        android:textAllCaps="false"

                        android:textStyle="bold"

                        android:textSize="16sp"

                        android:textColor="#FFFFFF"

                        android:backgroundTint="#0A6DA8"

                        app:cornerRadius="30dp"/>

                    <!-- SPACE -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <!-- LOGOUT -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogout"

                        android:layout_width="match_parent"
                        android:layout_height="58dp"

                        android:text="Logout"

                        android:textAllCaps="false"

                        android:textStyle="bold"

                        android:textSize="16sp"

                        android:textColor="#FFFFFF"

                        android:backgroundTint="#D9534F"

                        app:cornerRadius="30dp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

    <!-- ========================= -->
    <!-- RIGHT SESSION DRAWER -->
    <!-- ========================= -->
    <LinearLayout
        android:id="@+id/sessionDrawer"

        android:layout_width="320dp"
        android:layout_height="match_parent"

        android:layout_gravity="end"

        android:orientation="vertical"

        android:padding="24dp"

        android:background="@drawable/bg_glass_card">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Attendance Session"

            android:textColor="#FFFFFF"

            android:textSize="24sp"

            android:textStyle="bold"

            android:layout_marginTop="40dp"

            android:layout_marginBottom="28dp"/>

        <!-- STATUS -->
        <TextView
            android:id="@+id/tvSessionStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="🔴 INACTIVE"

            android:textColor="#FF6B6B"

            android:textSize="16sp"

            android:textStyle="bold"

            android:layout_marginBottom="20dp"/>

        <!-- BLUETOOTH -->
        <TextView
            android:id="@+id/tvBluetoothName"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Bluetooth:\nN/A"

            android:textColor="#CBE8FF"

            android:textSize="15sp"

            android:layout_marginBottom="20dp"/>

        <!-- TIMER -->
        <TextView
            android:id="@+id/tvSessionTimer"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="⏱ No Active Session"

            android:textColor="#8FE3FF"

            android:textSize="16sp"

            android:textStyle="bold"

            android:layout_marginBottom="30dp"/>

        <!-- TOGGLE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSessionToggle"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:text="Start Session"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="15sp"

            android:backgroundTint="#0A6DA8"

            app:cornerRadius="22dp"/>

        <!-- PUSH CALENDAR TO BOTTOM -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- CALENDAR BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalendar"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:text="Class Calendar >"

            android:layout_marginBottom="30dp"

            android:textAllCaps="false"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="15sp"

            android:backgroundTint="#2E8BFF"

            app:cornerRadius="22dp"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
