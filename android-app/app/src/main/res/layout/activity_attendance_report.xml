<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0F0B1A"
        android:padding="16dp">

        <!-- 📊 TITLE & MENU -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp">

            <!-- Title column (centered, true center of the screen) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="40dp"
                android:paddingRight="40dp">

                <!-- Row 1: Department (Session) -->
                <TextView
                    android:id="@+id/tvDepartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Department"
                    android:textColor="#8FE3FF"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:alpha="0.85"/>

                <!-- Divider dots -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="1dp"
                        android:background="#33FFFFFF"/>
                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="#558FE3FF"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:id="@+id/tvSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Section A"
                        android:textColor="#D0B4FF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="#558FE3FF"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"/>
                    <View
                        android:layout_width="18dp"
                        android:layout_height="1dp"
                        android:background="#33FFFFFF"/>
                </LinearLayout>

                <!-- Row 3: Class name (Code) -->
                <TextView
                    android:id="@+id/tvClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class Name"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="center"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/btnReportMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_hamburger"
                app:tint="#FFFFFF"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </RelativeLayout>


        <!-- 📅 DATE SELECTOR ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_date_selector_bar"
            android:padding="4dp">

            <!-- LEFT ARROW -->
            <ImageView
                android:id="@+id/btnDatePrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_circle_icon_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Previous date"/>

            <!-- DATE TEXT (clickable for date picker) -->
            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Today"
                android:textColor="#8FE3FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_calendar_day"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"/>

            <!-- RIGHT ARROW -->
            <ImageView
                android:id="@+id/btnDateNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_circle_icon_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Next date"/>
        </LinearLayout>

        <!-- 📋 REPORT LIST -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- STICKY HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_table_header"
                    android:layout_marginBottom="4dp"
                    android:minWidth="420dp">

                    <TextView android:layout_width="0dp" android:layout_weight="2" android:minWidth="140dp" android:layout_height="wrap_content" android:text="Name" android:textColor="#8FE3FF" android:textStyle="bold" android:textSize="15sp" android:padding="12dp" android:gravity="center_vertical" android:background="@android:color/transparent"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="90dp" android:layout_height="wrap_content" android:text="Roll" android:textColor="#8FE3FF" android:textStyle="bold" android:textSize="15sp" android:padding="12dp" android:gravity="center_vertical" android:background="@android:color/transparent"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="90dp" android:layout_height="wrap_content" android:text="Time" android:textColor="#8FE3FF" android:textStyle="bold" android:textSize="15sp" android:padding="12dp" android:gravity="center_vertical" android:background="@android:color/transparent"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="90dp" android:layout_height="wrap_content" android:text="Status" android:textColor="#8FE3FF" android:textStyle="bold" android:textSize="15sp" android:padding="12dp" android:gravity="center_vertical" android:background="@android:color/transparent"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerReport"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ═══════════════════════════════════════
         SIDE DRAWER – FILTER & ACTIONS
    ═══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#0F0B1E"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="52dp"
            android:paddingBottom="24dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp">

            <!-- ── DRAWER TITLE ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:background="#8FE3FF"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filter &amp; Actions"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ══════════════════════════════
                 SECTION 1 – SEARCH BY NAME
            ══════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_filter_section"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <!-- Label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="15sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEARCH BY NAME"
                        android:textColor="#8FE3FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>
                </LinearLayout>

                <!-- Name input -->
                <EditText
                    android:id="@+id/etSearchName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="Enter your name"
                    android:textColorHint="#4D8FE3FF"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center_vertical"
                    android:inputType="textPersonName"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Separate multiple names with commas"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

            <!-- ══════════════════════════════
                 SECTION 2 – SEARCH BY ROLL
            ══════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_filter_section"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <!-- Label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="15sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEARCH BY ROLL"
                        android:textColor="#B4FF91"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>
                </LinearLayout>

                <!-- Single / Multiple rolls -->
                <EditText
                    android:id="@+id/etSearchRoll"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="e.g. 3135, 3138"
                    android:textColorHint="#4DB4FF91"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center_vertical"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Separate with commas for multiple"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="2dp"/>

                <!-- Roll range divider label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#22FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  RANGE  "
                        android:textColor="#66FFFFFF"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#22FFFFFF"/>
                </LinearLayout>

                <!-- Roll range from-to -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etRollFrom"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search_input"
                        android:hint="From"
                        android:textColorHint="#4DB4FF91"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:gravity="center_vertical"
                        android:inputType="numberDecimal"
                        android:singleLine="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  →  "
                        android:textColor="#66FFFFFF"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etRollTo"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search_input"
                        android:hint="To"
                        android:textColorHint="#4DB4FF91"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:gravity="center_vertical"
                        android:inputType="numberDecimal"
                        android:singleLine="true"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter numeric portion of roll numbers"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

            <!-- ── APPLY / CLEAR ROW ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/btnApplyFilter"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Apply"
                    android:gravity="center"
                    android:textColor="#0A0B1A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_apply_btn"
                    android:clickable="true"
                    android:focusable="true"/>

                <View android:layout_width="10dp" android:layout_height="1dp"/>

                <TextView
                    android:id="@+id/btnClearFilters"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Clear"
                    android:gravity="center"
                    android:textColor="#CC8FE3FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_search_input"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- ── DIVIDER ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- ══════════════════════════════
                 SECTION 3 – ACTIONS
            ══════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIONS"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="2dp"/>

            <!-- Download -->
            <LinearLayout
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_input"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_download"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download full report"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Date Range -->
            <LinearLayout
                android:id="@+id/btnDateRange"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_input"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_date_range"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a date range"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Clear All Filters -->
            <LinearLayout
                android:id="@+id/btnClearAllFilters"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_clear_all_btn"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_clear_filter"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear all filters"
                    android:textColor="#FF6B6B"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>