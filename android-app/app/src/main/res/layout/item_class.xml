<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="175dp"
    android:layout_height="wrap_content"

    android:layout_marginEnd="10dp"

    app:cardBackgroundColor="#163449"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#29546B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="15dp">

        <!-- CLASS NAME -->
        <TextView
            android:id="@+id/tvClassName"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="DBMS"

            android:textColor="#FFFFFF"

            android:textSize="20sp"

            android:textStyle="bold"

            android:letterSpacing="0.01"/>

        <!-- DEPARTMENT -->
        <TextView
            android:id="@+id/tvDepartment"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="AIML | Sem 5th"

            android:textColor="#9EC2D9"

            android:textSize="13sp"

            android:layout_marginTop="6dp"/>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"

            android:alpha="0.08"

            android:background="#FFFFFF"/>

        <!-- STUDENTS -->
        <TextView
            android:id="@+id/tvStudents"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Students: 50"

            android:textColor="#E6F1F7"

            android:textSize="14sp"/>

        <!-- PRESENT -->
        <TextView
            android:id="@+id/tvPresent"

            android:layout_width="wrap_content"
            android:layout_height="20dp"

            android:text="Present: 20"

            android:textColor="#00FFA3"

            android:textStyle="bold"

            android:textSize="15sp"

            android:layout_marginTop="8dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
