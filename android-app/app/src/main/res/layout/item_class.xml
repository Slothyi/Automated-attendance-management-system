<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="245dp"
    android:layout_height="wrap_content"

    android:layout_marginEnd="18dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"

    android:backgroundTint="#163548"

    app:cardCornerRadius="36dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#29546B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- CLASS NAME -->
        <TextView
            android:id="@+id/tvClassName"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="DBMS"

            android:textColor="#FFFFFF"

            android:textSize="26sp"

            android:textStyle="bold"

            android:letterSpacing="0.01"/>

        <!-- DEPARTMENT -->
        <TextView
            android:id="@+id/tvDepartment"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="AIML"

            android:textColor="#9EC2D9"

            android:textSize="15sp"

            android:layout_marginTop="10dp"/>

        <!-- DIVIDER SPACE -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:alpha="0.08"
            android:background="#FFFFFF"/>

        <!-- STUDENTS -->
        <TextView
            android:id="@+id/tvStudents"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Students: 50"

            android:textColor="#E6F1F7"

            android:textSize="17sp"/>

        <!-- PRESENT -->
        <TextView
            android:id="@+id/tvPresent"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Present: 20"

            android:textColor="#00FFA3"

            android:textStyle="bold"

            android:textSize="18sp"

            android:layout_marginTop="14dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>