<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:padding="20dp"

    android:background="#0E0717">

    <!-- 🏫 CLASS NAME -->
    <TextView
        android:id="@+id/tvClassName"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_gravity="center"
        android:text="Class Name"

        android:textColor="#FFFFFF"

        android:textSize="30sp"

        android:textStyle="bold"/>

    <!-- 🆔 CLASS ID -->
    <TextView
        android:id="@+id/tvClassId"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Class ID"

        android:textColor="#BCA7F5"

        android:textSize="14sp"

        android:layout_marginTop="6dp"/>

    <!-- 📊 STATS -->
    <TextView
        android:id="@+id/tvStats"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Present: 0    Absent: 0    N/A: 0"

        android:textColor="#FFFFFF"

        android:textStyle="bold"

        android:textSize="16sp"

        android:layout_marginTop="14dp"

        android:layout_marginBottom="18dp"/>

    <!-- 📈 REPORT BUTTON -->
    <Button
        android:id="@+id/btnViewReport"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="View Attendance Report"

        android:textColor="#FFFFFF"

        android:backgroundTint="#7B3FF2"

        android:layout_marginBottom="20dp"/>

    <!-- 📋 TABLE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:padding="12dp"

        android:background="#2A1E42">

        <!-- 👤 NAME -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="Student Name"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="15sp"/>

        <!-- 🎫 ROLL -->
        <TextView
            android:layout_width="85dp"
            android:layout_height="wrap_content"

            android:gravity="center"

            android:text="Roll"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="15sp"/>

        <!-- ✅ STATUS -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"

            android:gravity="center"

            android:text="Status"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="15sp"/>
    </LinearLayout>

    <!-- 👨‍🎓 STUDENT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerStudents"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:layout_marginTop="12dp"/>
</LinearLayout>